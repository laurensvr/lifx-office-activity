# LIFX Cloud API token from https://cloud.lifx.com/settings
LIFX_TOKEN=

# Static IP of the MacBook on the wired UniFi network
MACBOOK_IP=

# Optional: which lights to control (default: all)
# LIFX_SELECTOR=group:Office

# Optional: consecutive missed pings before lights dim (default: 2 -> ~2 minutes)
# DIM_THRESHOLD=2

# Optional: consecutive missed pings before lights turn off (default: 5 -> ~5 minutes)
# OFF_THRESHOLD=5

# Optional: per-ping timeout in seconds (default: 1)
# PING_TIMEOUT_S=1

# Optional: brightness when dimmed (0.0-1.0, default 0.15)
# DIM_BRIGHTNESS=0.15

# Optional: brightness when fully on (0.0-1.0, default 1.0)
# FULL_BRIGHTNESS=1.0
