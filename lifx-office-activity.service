[Unit]
Description=LIFX office activity daemon (MacBook presence -> lights on/dim/off)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lifx-office-activity
ExecStart=/usr/bin/env node %h/lifx-office-activity/check.js
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
